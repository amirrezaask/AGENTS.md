{
  "name": "amirreza-agent-instructions",
  "private": true,
  "type": "module",
  "scripts": {
    "install:agents": "node tools/install.ts",
    "check:skills": "node tools/validate-skills.ts",
    "lint": "NODE_OPTIONS=\"--import tsx\" oxlint tools skills/factory/assets && oxfmt --check tools skills/factory/assets/task-board/server.ts package.json .oxlintrc.json && node tools/check-factory-ui.ts --lint",
    "test": "node --test tools/install.test.ts tools/factory-board.test.ts",
    "check:types": "tsc --noEmit --strict --types node --esModuleInterop --module nodenext --target es2023 --allowImportingTsExtensions tools/*.ts skills/factory/assets/task-board/server.ts && node tools/check-factory-ui.ts",
    "factory:board": "node --preserve-symlinks-main docs/tasks/server.ts"
  },
  "dependencies": {
    "effect": "3.22.4"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/oxide": "^4.1.18",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.63.0",
    "marked": "^17.0.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-plugin-anti-slop": "https://codeload.github.com/dmmulroy/anti-slop/tar.gz/13909c9e07590f5a85d93c62712259fe14a883f7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
